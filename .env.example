# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI API Configuration (optional - for direct API calls)
# If not set, the app will use mock data in development
# In production, use Supabase Edge Functions with server-side API keys
# VITE_AI_API_KEY=
# VITE_AI_API_URL=

# For Supabase Edge Functions (set in Supabase dashboard > Settings > Edge Functions)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
